# Forge Framework — Development Environment
# Copy to .env and fill in values: cp .env.example .env

# Database (Postgres)
DATABASE_URL=postgres://forge:forge_dev@localhost:5432/forge

# Redis
REDIS_URL=redis://localhost:6379

# File Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=forge_dev
S3_SECRET_KEY=forge_dev_secret
S3_BUCKET=forge-files
S3_REGION=us-east-1

# Server
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# Auth
SESSION_SECRET=change-me-to-a-random-string
API_KEY_SALT_ROUNDS=10

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
