# Forge Framework — Development Environment
# Copy to .env and fill in values
# NEVER commit .env to git

# ─── Database ─────────────────────────────────────────────────────────────────
FORGE_DB_HOST=localhost
FORGE_DB_PORT=5432
FORGE_DB_USER=forge
FORGE_DB_PASSWORD=forge_dev_password_change_in_prod
FORGE_DB_NAME=forge_control

# ─── Redis ────────────────────────────────────────────────────────────────────
FORGE_REDIS_URL=redis://:forge_redis_dev_change_in_prod@localhost:6379

# ─── File Storage (MinIO in dev, S3-compatible in prod) ───────────────────────
FORGE_STORAGE_ENDPOINT=http://localhost:9000
FORGE_STORAGE_BUCKET=forge-dev
FORGE_STORAGE_ACCESS_KEY=forge_minio
FORGE_STORAGE_SECRET_KEY=forge_minio_dev_change_in_prod

# ─── Auth ─────────────────────────────────────────────────────────────────────
FORGE_SESSION_SECRET=change-this-to-32-random-chars-minimum
FORGE_API_KEY_SALT=change-this-to-another-32-random-chars

# ─── Server ───────────────────────────────────────────────────────────────────
FORGE_PORT=8000
FORGE_ENV=development
FORGE_LOG_LEVEL=debug

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
